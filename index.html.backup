/* ============================================================
   STATE & HELPERS
   ============================================================ */
const $=s=>document.querySelector(s), $$=s=>document.querySelectorAll(s);
const store={
  get(k,d){try{const v=localStorage.getItem(k);return v?JSON.parse(v):d;}catch(e){return d;}},
  set(k,v){try{localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
};
let doneDays=store.get('ielts_done',{});
let vocabState=store.get('ielts_vocab',{});
let gramDone=store.get('ielts_gram',{});
let readingState=store.get('ielts_reading',{});
let listenState=store.get('ielts_listen',{});
let todayIdx=0; // computed below

let curDay=1;
let vocabFilter="all", vocabSetFilter="all";

const DAY_NAMES=["Chủ nhật","Thứ hai","Thứ ba","Thứ tư","Thứ năm","Thứ sáu","Thứ bảy"];

function today(){
  const d=new Date();
  const y=d.getFullYear(),m=d.getMonth(),dt=d.getDate();
  // approximate day-of-month -> map to 1..21 (start of current cycle)
  return ((dt-1)%21)+1;
}

function phaseOf(d){return d<=7?1:d<=14?2:3;}
function phaseName(p){return p===1?"Giai đoạn 1 — Nền tảng":p===2?"Giai đoạn 2 — Phát triển":"Giai đoạn 3 — Tính giờ & Mock";}

function daysDoneCount(){
  let c=0;for(const k in doneDays){if(doneDays[k])c++;}return c;
}
function totalPhaseDone(p){let c=0;for(let i=1;i<=21;i++){if(phaseOf(i)===p&&doneDays[i])c++;}return c;}

/* ============================================================
   NAVIGATION
   ============================================================ */
function go(screen){
  $$('.nav-item,.ttab').forEach(n=>n.classList.toggle('active',n.dataset.screen===screen));
  $$('.screen').forEach(s=>s.classList.remove('active'));
  $('#screen-'+screen).classList.add('active');
  window.scrollTo({top:0,behavior:'smooth'});
  updateNavPct();
}
function bindNav(){
  $$('.nav-item,.ttab').forEach(n=>{
    n.addEventListener('click',()=>go(n.dataset.screen));
  });
}

/* ============================================================
   HOME
   ============================================================ */
function renderHome(){
  const grid=$('#progress-grid');grid.innerHTML='';
  const t=today();
  todayIdx=t;
  for(let i=1;i<=21;i++){
    const el=document.createElement('div');
    el.className='dday'+(doneDays[i]?' done':'')+(i===t?' today':'');
    el.innerHTML=`<div class="chk">${doneDays[i]?'✓':''}</div><div class="n">D${i}</div><div class="lbl">${DAYS[i-1].title}</div>`;
    const check=el.querySelector('.chk');
    el.addEventListener('click',(e)=>{
      if(e.target===check){doneDays[i]=!doneDays[i];store.set('ielts_done',doneDays);renderHome();updateNavPct();}
      else {curDay=i;renderLesson();go('lessons');}
    });
    grid.appendChild(el);
  }
  // stats
  const done=daysDoneCount();
  $('#stat-days').textContent=done;
  $('#stat-pct').textContent=Math.round(done/21*100)+'%';
  $('#stat-phase').textContent=phaseName(phaseOf(t));
  // sidebar progress
  $('#sidebar-progress').style.width=(done/21*100)+'%';
  $('#sidebar-progress-text').textContent=done+'/21 ngày';
  // today card
  const tp=phaseOf(t);
  let phaseProg=totalPhaseDone(tp), phaseLen=tp===1?7:7;
  const pc=Math.round(phaseProg/phaseLen*100);
  $('#today-card').innerHTML=`
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px">
        <h3 style="margin:0">Hôm nay: ${DAY_NAMES[new Date().getDay()]} — <span style="color:var(--accent)">Ngày ${t}</span></h3>
        <button class="btn primary small" data-open-day="${t}">Mở bài học ngày ${t} →</button>
      </div>
      <p style="color:var(--muted);margin:10px 0 6px;font-size:13.5px"><b style="color:var(--gold)">${DAYS[t-1].title}</b> — ${DAYS[t-1].tag}</p>
      <p style="color:var(--muted);margin:0 0 12px;font-size:13px">${DAYS[t-1].focus}</p>
      <div><span class="tag acc">${phaseName(tp)}</span><span class="tag">${sectProgressLabel()}</span></div>
      <div class="pbar" style="margin-top:10px"><div class="fill" style="width:${pc}%"></div></div>
      <div style="font-size:12px;color:var(--muted);margin-top:5px">Tiến độ ${phaseName(tp)}: ${phaseProg}/${phaseLen} ngày</div>
    </div>`;
  const btn=$('#today-card [data-open-day]');
  if(btn)btn.addEventListener('click',()=>{curDay=t;renderLesson();go('lessons');});
  $('#phase1').classList.toggle('current',tp===1);
  $('#phase2').classList.toggle('current',tp===2);
  $('#phase3').classList.toggle('current',tp===3);
}
function sectProgressLabel(){
  const g=daysDoneCount();
  if(g===0)return "Chưa bắt đầu";
  if(g<7)return "Giai đoạn 1";
  if(g<14)return "Giai đoạn 2";
  return "Giai đoạn 3";
}

/* ============================================================
   LESSONS
   ============================================================ */
function renderDayPicker(){
  const p=$('#day-picker');p.innerHTML='';
  DAYS.forEach((d,i)=>{
    const b=document.createElement('button');
    b.className='fbtn'+(d.n===curDay?' active':'');
    b.textContent='D'+d.n;
    b.addEventListener('click',()=>{curDay=d.n;renderDayPicker();renderLesson();});
    p.appendChild(b);
  });
}
function renderLesson(){
  const d=DAYS[curDay-1];
  const el=$('#lesson-detail');
  const done=!!doneDays[curDay];
  el.innerHTML=`
    <div class="card">
      <div class="lesson-head">
        <h3>Ngày ${d.n} — ${d.title} <span class="tag ${phaseOf(d.n)===1?'acc':phaseOf(d.n)===2?'amber':'red'}">${phaseName(phaseOf(d.n))}</span></h3>
        <button class="btn ${done?'success':'primary'}" id="toggle-day-${d.n}">${done?'✓ Đã hoàn thành':'Đánh dấu hoàn thành'}</button>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 14px"><span class="tag green">${d.tag}</span></div>
      <div class="lesson-obj">
        <h4>🎯 Mục tiêu học tập</h4><ul>${d.obj.map(o=>`<li>${o}</li>`).join('')}</ul>
      </div>
      <h4>📌 Trọng tâm</h4>
      <p style="color:var(--txt)">${d.focus}</p>
      <div class="products">
        <h4>📦 Sản phẩm cần nộp</h4><ul>${d.products.map(p=>`<li>${p}</li>`).join('')}</ul>
      </div>
      <div class="chips">${relatedChips(d.n)}</div>
      <div class="two-btn">
        <button class="btn" id="lesson-prev" ${d.n<=1?'disabled':''}>← Ngày ${d.n-1}</button>
        <button class="btn" id="lesson-next" ${d.n>=21?'disabled':''}>Ngày ${d.n+1} →</button>
      </div>
    </div>`;
  const t=$('#toggle-day-'+d.n);
  if(t)t.addEventListener('click',()=>{doneDays[curDay]=!doneDays[curDay];store.set('ielts_done',doneDays);renderLesson();renderHome();});
  const pv=$('#lesson-prev');if(pv&&!pv.disabled)pv.addEventListener('click',()=>{curDay--;renderDayPicker();renderLesson();});
  const nx=$('#lesson-next');if(nx&&!nx.disabled)nx.addEventListener('click',()=>{curDay++;renderDayPicker();renderLesson();});
}
function relatedChips(n){
  const links=[];
  // reading passages by day
  const rd={1:'p1',2:'p2',3:'p3',4:'p4',7:'p7',8:'p8'};
  const ls={1:'p1',2:'p2',3:'p3',4:'p4',7:'p7',8:'p8'};
  if(rd[n])links.push(`<button class="chip" onclick="go('reading')">📖 Reading: ${PASSAGES[rd[n]].focus}</button>`);
  if(ls[n])links.push(`<button class="chip" onclick="go('listening')">🎧 Listening: ${LISTENING[ls[n]].title.split(' — ')[1]}</button>`);
  if(n===1||n===2||n===3||n===6||n===8||n===7)links.push(`<button class="chip" onclick="go('writing')">📝 Writing: ${WRITING.find(w=>w.day.startsWith('Ngày '+n))?'bài ngày '+n:'mở section'}</button>`);
  if(n===1||n===5||n===10)links.push(`<button class="chip" onclick="go('grammar')">✍️ Grammar: ${n===1?'Ngày 1':n===5?'Ngày 5':'Ngày 10'}</button>`);
  if(n===1||n===4||n===10||n===13)links.push(`<button class="chip" onclick="go('speaking')">🎤 Speaking: phần ngày ${n}</button>`);
  return links.join('');
}

/* ============================================================
   READING — quiz engine + TTS
   ============================================================ */
let speaking=null;
function getVoices(){
  if(!('speechSynthesis' in window))return null;
  const vs=speechSynthesis.getVoices();
  const en=vs.filter(v=>/^en[-_]/i.test(v.lang));
  return en.length?en:vs.filter(v=>/^en/i.test(v.lang));
}
function speak(text,rate=0.95,onDone){
  if(!('speechSynthesis' in window)){alert('Trình duyệt này không hỗ trợ TTS (Web Speech API). Nhấn đọc to sẽ không hoạt động — thử Chrome/Edge.');return;}
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  const vs=getVoices();
  const pref=vs.find(v=>/en-US/i.test(v.name))||vs[0];
  if(pref)u.voice=pref;
  u.lang='en-US';u.rate=rate;u.pitch=1;
  if(onDone)u.onend=onDone;
  speechSynthesis.speak(u);
}
function stopSpeak(){if('speechSynthesis' in window)speechSynthesis.cancel();}

let readingTimers={};
function renderReading(){
  const c=$('#reading-container');c.innerHTML='';
  Object.keys(PASSAGES).forEach(pid=>{
    const p=PASSAGES[pid];
    const st=readingState[pid]||{score:getReadingScore(pid),answered:{},timerOn:false};
    const sec=document.createElement('div');
    sec.className='card';
    sec.innerHTML=`
      <div class="readpanel">
        <div class="readmeta">
          <h3 style="margin:0">${p.title}</h3>
          <span class="tag acc">${p.focus}</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          <button class="btn primary small" data-p="${pid}" data-act="read">🔊 Đọc to (English)</button>
          <button class="btn small" data-p="${pid}" data-act="stop">⏹ Dừng</button>
          <button class="btn small" data-p="${pid}" data-act="slow">🐢 Chậm</button>
          <button class="btn small" data-p="${pid}" data-act="fast">🐇 Nhanh</button>
          <button class="btn small" data-p="${pid}" data-act="timer">⏱ Timer: ${st.timerOn?'BẬT':'TẮT'}</button>
          <span class="tag" id="timer-${pid}">${st.timerOn?'00:00':'—'}</span>
        </div>
        <div class="vtxt" id="vtxt-${pid}">${p.text}</div>
      </div>
      <h4>📋 Câu hỏi (điểm: <span id="score-${pid}">${st.score}/${p.questions.length}</span>)</h4>
      <div class="qlist" id="qlist-${pid}"></div>`;
    c.appendChild(sec);

    // bind actions
    sec.querySelectorAll('[data-act]').forEach(b=>{
      b.addEventListener('click',()=>{
        const act=b.dataset.act,pid2=b.dataset.p;
        const txt=plainFromHtml(PASSAGES[pid2].text);
        if(act==='read')speak(txt,0.95,()=>{});
        else if(act==='stop')stopSpeak();
        else if(act==='slow')speak(txt,0.6,()=>{});
        else if(act==='fast')speak(txt,1.1,()=>{});
        else if(act==='timer'){
          st.timerOn=!st.timerOn;
          readingState[pid2]=st;store.set('ielts_reading',readingState);
          b.textContent='⏱ Timer: '+(st.timerOn?'BẬT':'TẮT');
          const tEl=$('#timer-'+pid2);
          if(st.timerOn){startReadingTimer(pid2,tEl);}else{clearInterval(readingTimers[pid2]);tEl.textContent='—';}
        }
      });
    });
    if(st.timerOn){const tEl=$('#timer-'+pid2||$('#timer-'+pid));startReadingTimer(pid,tEl);}
    renderReadingQuestions(pid,$('#qlist-'+pid));
  });
}
let readingStart={};
function startReadingTimer(pid,el){
  clearInterval(readingTimers[pid]);
  if(!readingStart[pid])readingStart[pid]=Date.now();
  readingTimers[pid]=setInterval(()=>{
    const s=Math.floor((Date.now()-readingStart[pid])/1000);
    const m=String(Math.floor(s/60)).padStart(2,'0'),ss=String(s%60).padStart(2,'0');
    if(el)el.textContent=`${m}:${ss}`;
  },1000);
}
function getReadingScore(pid){
  const p=PASSAGES[pid];let s=0;
  p.questions.forEach((q,i)=>{if(readingState[pid]&&readingState[pid].answered&&readingState[pid].answered[i])s++;});
  return s;
}
function plainFromHtml(html){
  const d=document.createElement('div');d.innerHTML=html;return d.textContent.replace(/\s+/g,' ').trim();
}
function isAns(q,sel){
  if(q.t==='tfng')return q.ans===sel;
  if(q.t==='mc')return q.ans===parseInt(sel);
  if(q.t==='head')return q.ans===sel;
  if(q.t==='comp')return q.ans.includes(sel.toLowerCase());
}
function renderReadingQuestions(pid,host){
  const p=PASSAGES[pid];
  let correct=getReadingScore(pid);
  host.innerHTML=p.questions.map((q,i)=>{
    const ansState=readingState[pid]&&readingState[pid].answered&&readingState[pid].answered[i];
    const sel=readingState[pid]&&readingState[pid].sel&&readingState[pid].sel[i];
    let body='';
    if(q.t==='tfng'){
      body=`<div class="opts">${['TRUE','FALSE','NG'].map(o=>`<div class="opt ${ansState&&q.ans===o?'correct':''} ${ansState&&sel===o&&q.ans!==o?'wrong':''}" data-o="${o}"><span class="key">${o}</span></div>`).join('')}</div>`;
    }else if(q.t==='mc'){
      body=`<div class="opts">${q.opts.map((o,idx)=>`<div class="opt ${ansState&&q.ans===idx?'correct':''} ${ansState&&sel===idx&&q.ans!==idx?'wrong':''}" data-o="${idx}"><span class="key">${String.fromCharCode(65+idx)}</span>${o.slice(o.indexOf('.')>=0?o.indexOf('.')+1:2).trim()}</div>`).join('')}</div>`;
    }else if(q.t==='head'){
      if(q.intro){body=`<div style="color:var(--muted);font-size:13.5px">Đoạn A là phần mở đầu (đã có tiêu đề).</div>`;}
      else body=`<div class="opts">${q.opts.map(o=>`<div class="opt ${ansState&&q.ans===o?'correct':''} ${ansState&&sel===o&&q.ans!==o?'wrong':''}" data-o="${o}">${o}</div>`).join('')}</div>`;
    }else if(q.t==='comp'){
      body=`<div style="display:flex;gap:8px"><input class="input" id="cinp-${pid}-${i}" placeholder="Nhập câu trả lời (tối đa 3 từ)" ${ansState?'disabled':''} value="${ansState?(readingState[pid].textin[i]||''):''}"><button class="btn small" data-ci="${i}" ${ansState?'disabled':''}>Kiểm tra</button></div><div style="font-size:12px;color:var(--dim);margin-top:4px">${q.clue||''}</div>`;
    }
    const fb=ansState?`<div class="feedback ${ansState.ok?'ok':'no'} show" >${ansState.ok?'✅ Đúng! ':'❌ $${q.t==='comp'?'':'Sai. Đáp án: '+prettifyAns(q)+'. '} '}${ansState.correct?'':'📖 '+plainFromHtml(q.explain||'')}</div>`:(q.t==='comp'?'':'');
    return `<div class="qblock" data-q="${i}">
      <div class="qhead"><span class="qnum">${i+1}</span>${q.stem}</div>
      ${q.t==='comp'?'':`<div class="qstem">${q.explain?'':''}</div>`}
      ${body}${fb}</div>`;
  }).join('');

  host.querySelectorAll('[data-o]').forEach(o=>{
    o.addEventListener('click',()=>{
      const qb=o.closest('.qblock');const idx=parseInt(qb.dataset.q);const q=p.questions[idx];
      selectionAnswer(pid,idx,q,qb,o.dataset.o);
    });
  });
  host.querySelectorAll('[data-ci]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const qb=btn.closest('.qblock');const idx=parseInt(qb.dataset.q);const q=p.questions[idx];
      const inp=$('#cinp-'+pid+'-'+idx);const val=inp.value.trim().toLowerCase();
      completionAnswer(pid,idx,q,qb,val);
    });
  });
}
function prettifyAns(q){if(q.t==='comp')return q.ans[0];if(q.t==='tfng')return q.ans;if(q.t==='mc')return 'Đáp án '+String.fromCharCode(65+q.ans);if(q.t==='head')return q.ans;}
function selectionAnswer(pid,idx,q,qb,sel){
  const ok=isAns(q,sel);
  readingState[pid]=readingState[pid]||{answered:{},sel:{},textin:{}};
  readingState[pid].answered[idx]=ok;
  readingState[pid].sel[idx]=sel;
  store.set('ielts_reading',readingState);
  const options=qb.querySelectorAll('.opt');
  options.forEach(o=>o.classList.remove('sel','correct','wrong'));
  options.forEach(o=>{
    if(isAns(q,o.dataset.o))o.classList.add('correct');
    if(o===qb.querySelector(`[data-o="${sel}"]`)&&!ok)o.classList.add('wrong');
  });
  let fb=qb.querySelector('.feedback');
  if(!fb){fb=document.createElement('div');fb.className='feedback';qb.appendChild(fb);}
  fb.className='feedback show '+(ok?'ok':'no');
  fb.innerHTML=(ok?'✅ Đúng! ':'❌ Sai. Đáp án: '+prettifyAns(q)+'. ')+(q.t==='head'?'':'📖 '+plainFromHtml(q.explain||''));
  const sc=$('#score-'+pid);if(sc)sc.textContent=getReadingScore(pid)+'/'+p.questions.length;
}
function completionAnswer(pid,idx,q,qb,val){
  const ok=q.ans.includes(val);
  readingState[pid]=readingState[pid]||{answered:{},sel:{},textin:{}};
  readingState[pid].answered[idx]=ok;
  readingState[pid].textin[idx]=val;
  store.set('ielts_reading',readingState);
  let fb=qb.querySelector('.feedback');
  if(!fb){fb=document.createElement('div');fb.className='feedback';qb.appendChild(fb);}
  fb.className='feedback show '+(ok?'ok':'no');
  if(ok)fb.innerHTML='✅ Đúng! Anh: '+q.ans[0];
  else fb.innerHTML='❌ Sai. Đáp án: '+q.ans[0]+'. 📖 '+plainFromHtml(q.explain||'');
  fb.scrollIntoView({block:'nearest'});
  const sc=$('#score-'+pid);if(sc)sc.textContent=getReadingScore(pid)+'/'+p.questions.length;
  const inp=$('#cinp-'+pid+'-'+idx);if(inp)inp.disabled=true;
}

/* ============================================================
   LISTENING — TTS driven
   ============================================================ */
let listenRate=0.95, listenHighlight=false, listenCur=null;
function renderListening(){
  const c=$('#listening-container');c.innerHTML='';

  // Controls
  const ctl=document.createElement('div');
  ctl.className='card';
  ctl.innerHTML=`
    <h3>🎛 Cài đặt nghe</h3>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn small" id="lspeed-n">Tốc độ: Chuẩn (0.9x)</button>
      <button class="btn small" id="lspeed-f">Tốc độ: Nhanh (1.1x) ⏩</button>
      <button class="btn small" id="lhill">✨ Tô sáng theo dòng (Karaoke): <span id="lhill-state">TẮT</span></button>
    </div>
    <p style="color:var(--muted);font-size:12.5px;margin:10px 0 0">Giống IELTS thật: bạn được <b>nghe nhiều lần</b>. Tốc độ Nhanh mô phỏng độ khó cao hơn.</p>`;
  c.appendChild(ctl);
  $('#lspeed-n').addEventListener('click',()=>{listenRate=0.95;$('#lspeed-n').textContent='Tốc độ: Chuẩn (0.9x)';$('#lspeed-f').textContent='Tốc độ: Nhanh (1.1x) ⏩';});
  $('#lspeed-f').addEventListener('click',()=>{listenRate=1.1;$('#lspeed-n').textContent='Tốc độ: Chuẩn (0.9x)';$('#lspeed-f').textContent='Tốc độ: Nhanh (1.1x) ⏩';});
  $('#lhill').addEventListener('click',()=>{listenHighlight=!listenHighlight;$('#lhill-state').textContent=listenHighlight?'BẬT':'TẮT';});

  // Sections explanation
  const ssec=document.createElement('div');ssec.className='card';
  ssec.innerHTML=`<h3>📊 4 cấp độ Listening (theo chuẩn IELTS)</h3>`+
    LISTENING_SECTIONS.map(s=>`<div class="lesson-obj" style="margin-bottom:8px"><h4 style="color:var(--accent)">${s.level} <span class="tag amber">${s.diff}</span></h4><p style="margin:2px 0 0;color:var(--muted);font-size:13px">${s.intro}</p></div>`).join('');
  c.appendChild(ssec);

  // Each listening exercise
  Object.keys(LISTENING).forEach(pid=>{
    const ex=LISTENING[pid];
    const st=listenState[pid]||{score:getListenScore(pid),answered:{}};
    const card=document.createElement('div');card.className='card';card.id='lc-'+pid;
    card.innerHTML=`
      <div class="readpanel">
        <div class="readmeta">
          <h3>${ex.title}</h3><span class="tag acc">${ex.source}</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
          <button class="btn primary small" data-lp="${pid}" data-la="play">🎧 Nghe lại lần ${st.times||0}</button>
          <button class="btn small" data-lp="${pid}" data-la="stop">⏹ Dừng</button>
          <span class="tag green">Điểm: <span id="ls-${pid}">${st.score}/${ex.questions.length}</span></span>
        </div>
        <div class="vtxt" id="lvtxt-${pid}">${ex.text}</div>
      </div>
      <h4>❓ Câu hỏi nghe hiểu</h4>
      <div class="qlist" id="lq-${pid}"></div>`;
    c.appendChild(card);
    const play=card.querySelector('[data-la="play"]');
    play.addEventListener('click',()=>{
      const txt=plainFromHtml(ex.text);
      listenCur={pid,div:card,rate:listenRate};
      const times=(st.times||0)+1;
      st.times=times;listenState[pid]=st;store.set('ielts_listen',listenState);
      play.textContent='🎧 Nghe lại lần '+times;
      if(listenHighlight){highlightSpeak(txt,card);}else{speak(txt,listenRate,()=>{listenCur=null;});}
    });
    card.querySelector('[data-la="stop"]').addEventListener('click',stopSpeak);
    renderListenQuestions(pid,$('#lq-'+pid));
  });
  updateListeningNav();
}
function highlightSpeak(fullHtml,card){
  // karaoke: speak sentence by sentence, highlight current
  if(!('speechSynthesis' in window)){speak(fullHtml,listenRate);return;}
  const d=document.createElement('div');d.innerHTML=fullHtml;
  const p=document.createElement('div');p.textContent=/<p>/i.test(fullHtml)?'':fullHtml.replace(/<[^>]+>/g,'');
  const sents=plainFromHtml(fullHtml).match(/[^.!?]+[.!?]+/g)||[plainFromHtml(fullHtml)];
  let i=0;
  const vtxt=card.querySelector('.vtxt');const full=plainFromHtml(fullHtml);
  const speakOne=()=>{
    if(i>=sents.length){vtxt.innerHTML=vtxt.dataset.orig||full;vtxt.querySelectorAll('.hl').forEach(x=>x.classList.remove('hl'));listenCur=null;return;}
    const s=sents[i];
    // build html with this sentence highlighted
    vtxt.innerHTML=full.replace(escapeReg(s),`<span class="hl">${escapeHtml(s)}</span>`);
    const u=new SpeechSynthesisUtterance(s.replace(/<[^>]+>/g,''));
    const vs=getVoices();const pref=vs.find(v=>/en-US/i.test(v.name))||vs[0];
    if(pref)u.voice=pref;u.lang='en-US';u.rate=listenRate;
    u.onend=()=>{i++;speakOne();};
    u.onerror=()=>{i++;speakOne();};
    speechSynthesis.speak(u);
  };
  if(!card.querySelector('.vtxt').dataset.orig)card.querySelector('.vtxt').dataset.orig=full;
  speakOne();
}
function escapeReg(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
function escapeHtml(s){return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function getListenScore(pid){const ex=LISTENING[pid];let s=0;(ex.questions||[]).forEach((q,i)=>{if(listenState[pid]&&listenState[pid].answered&&listenState[pid].answered[i])s++;});return s;}
function isLAns(q,sel){
  if(q.t==='mc')return q.ans===parseInt(sel);
  if(q.t==='gap')return q.ans.includes(String(sel).toLowerCase().trim());
  return false;
}
function renderListenQuestions(pid,host){
  const ex=LISTENING[pid];
  host.innerHTML=ex.questions.map((q,i)=>{
    const ansState=listenState[pid]&&listenState[pid].answered&&listenState[pid].answered[i];
    const sel=listenState[pid]&&listenState[pid].sel&&listenState[pid].sel[i];
    let body='';
    if(q.t==='mc'){
      body=`<div class="opts">${q.opts.map((o,idx)=>`<div class="opt ${ansState&&q.ans===idx?'correct':''} ${ansState&&sel===idx&&q.ans!==idx?'wrong':''}" data-o="${idx}"><span class="key">${String.fromCharCode(65+idx)}</span>${o.slice(o.indexOf('.')>=0?o.indexOf('.')+1:2).trim()}</div>`).join('')}</div>`;
    }else if(q.t==='gap'){
      body=`<div style="display:flex;gap:8px;flex-wrap:wrap"><input class="input" id="linp-${pid}-${i}" placeholder="Nghe và điền vào chỗ trống (tối đa 3 từ)" ${ansState?'disabled':''} value="${ansState?(listenState[pid].textin[i]||''):''}"><button class="btn small" data-li="${i}" ${ansState?'disabled':''}>Kiểm tra</button></div>`;
    }
    const fb=ansState?`<div class="feedback ${ansState.ok?'ok':'no'} show">${ansState.ok?'✅ Đúng! ':'❌ Sai. Đáp án: '+q.ans[0]+'. '}${ansState.correct||ansState.ok?'':''}📖 ${escapeHtml((q.explain||''))}</div>`:'';
    return `<div class="qblock" data-liq="${i}"><div class="qhead"><span class="qnum">${i+1}</span>${q.stem}</div>${body}${fb}</div>`;
  }).join('');
  host.querySelectorAll('[data-o]').forEach(o=>{
    o.addEventListener('click',()=>{
      const idx=parseInt(o.closest('.qblock').dataset.liq),q=ex.questions[idx];
      listenState[pid]=listenState[pid]||{answered:{},sel:{},textin:{}};
      const ok=isLAns(q,o.dataset.o);
      listenState[pid].answered[idx]=ok;listenState[pid].sel[idx]=o.dataset.o;
      store.set('ielts_listen',listenState);
      const qb=o.closest('.qblock');
      qb.querySelectorAll('.opt').forEach(x=>x.classList.remove('sel','correct','wrong'));
      qb.querySelectorAll('.opt').forEach(x=>{if(isLAns(q,x.dataset.o))x.classList.add('correct');if(x===o&&!ok)x.classList.add('wrong');});
      let fb=qb.querySelector('.feedback');if(!fb){fb=document.createElement('div');fb.className='feedback';qb.appendChild(fb);}
      fb.className='feedback show '+(ok?'ok':'no');
      fb.innerHTML=(ok?'✅ Đúng! ':'❌ Sai. Đáp án: '+q.ans[0]+'. ')+'📖 '+escapeHtml((q.explain||''));
      const sc=$('#ls-'+pid);if(sc)sc.textContent=getListenScore(pid)+'/'+ex.questions.length;
      updateListeningNav();
    });
  });
  host.querySelectorAll('[data-li]').forEach(btn=>{
    btn.addEventListener('click',()=>{
      const idx=parseInt(btn.closest('.qblock').dataset.liq),q=ex.questions[idx];
      const inp=$('#linp-'+pid+'-'+idx);const val=inp.value.trim().toLowerCase();
      listenState[pid]=listenState[pid]||{answered:{},sel:{},textin:{}};
      const ok=isLAns(q,val);listenState[pid].answered[idx]=ok;listenState[pid].textin[idx]=val;
      store.set('ielts_listen',listenState);
      const qb=btn.closest('.qblock');
      let fb=qb.querySelector('.feedback');if(!fb){fb=document.createElement('div');fb.className='feedback';qb.appendChild(fb);}
      fb.className='feedback show '+(ok?'ok':'no');
      fb.innerHTML=ok?'✅ Đúng! Đáp án: '+q.ans[0]:'❌ Sai. Đáp án: '+q.ans[0]+'. 📖 '+escapeHtml((q.explain||''));
      inp.disabled=true;
      const sc=$('#ls-'+pid);if(sc)sc.textContent=getListenScore(pid)+'/'+ex.questions.length;
      updateListeningNav();
    });
  });
}
function updateListeningNav(){
  let total=0,done=0;
  Object.keys(LISTENING).forEach(pid=>{const ex=LISTENING[pid];total+=ex.questions.length;done+=getListenScore(pid);});
  $('#nav-listening-pct').textContent=done+'/'+total;
}

/* ============================================================
   VOCABULARY — flashcards
   ============================================================ */
function vocabKnown(en){return vocabState[en]==='k';}
function vocabUnknown(en){return vocabState[en]==='u';}
function renderVocabFilters(){
  const f=$('#vocab-filters');f.innerHTML='';
  const days=['all',...new Set(VOCAB.map(v=>v.day))];
  days.forEach(d=>{
    const b=document.createElement('button');
    b.className='fbtn'+(vocabFilter===d?' active':'');
    b.textContent=d==='all'?'Tất cả':d;
    b.addEventListener('click',()=>{vocabFilter=d;renderVocabFilters();renderVocab();});
    f.appendChild(b);
  });
}
function vocabPool(){
  let pool=[...VOCAB];
  if(vocabFilter!=='all')pool=pool.filter(v=>v.day===vocabFilter);
  if(vocabSetFilter==='known')pool=pool.filter(v=>vocabState[v.en]==='k');
  else if(vocabSetFilter==='unknown')pool=pool.filter(v=>vocabState[v.en]==='u');
  else if(vocabSetFilter==='none')pool=pool.filter(v=>!vocabState[v.en]);
  return pool;
}
function renderVocab(){
  const grid=$('#vocab-grid');
  let pool=vocabPool();
  // spaced repetition: repeat unknown cards more
  const repeatHard=pool.filter(v=>vocabState[v.en]==='u');
  pool=[...pool,...repeatHard,...repeatHard];
  if(shuffled)pool=shuffle(pool);
  grid.innerHTML='';
  pool.forEach(v=>{
    const c=document.createElement('div');
    c.className='flip';c.dataset.en=v.en;
    c.innerHTML=`
      <div class="flip-inner">
        <div class="flip-face"><div class="hint">Nhấn để lật</div><div class="en">${v.en}</div><div class="sect" style="font-size:11px;color:var(--dim);margin-top:6px">${v.day}</div></div>
        <div class="flip-face flip-back"><div class="vn">🇻🇳 ${v.vn}</div></div>
      </div>
      <div style="display:flex;gap:6px;margin-top:8px">
        <button class="btn small ${vocabKnown(v.en)?'success':''}" data-vk="1">✓ Biết</button>
        <button class="btn small danger" data-vu="1">✗ Chưa biết</button>
      </div>`;
    c.querySelector('.flip-inner').addEventListener('click',()=>c.classList.toggle('flipped'));
    c.querySelector('[data-vk]').addEventListener('click',e=>{e.stopPropagation();vocabState[v.en]='k';store.set('ielts_vocab',vocabState);renderVocab();renderVocabProgress();});
    c.querySelector('[data-vu]').addEventListener('click',e=>{e.stopPropagation();vocabState[v.en]='u';store.set('ielts_vocab',vocabState);renderVocab();renderVocabProgress();});
    grid.appendChild(c);
  });
  renderVocabProgress();
}
function renderVocabProgress(){
  const known=Object.values(vocabState).filter(x=>x==='k').length;
  const unknown=Object.values(vocabState).filter(x=>x==='u').length;
  const pct=Math.round(known/VOCAB.length*100);
  $('#vocab-progress').style.width=pct+'%';
  $('#vocab-progress-text').textContent=`Biết ${known} · Chưa biết ${unknown} · Tổng ${VOCAB.length} · Đã học ${Math.round((known+unknown)/VOCAB.length*100)}%`;
  updateVocabNav();
}
function updateVocabNav(){
  const known=Object.values(vocabState).filter(x=>x==='k').length;
  $('#nav-vocab-pct').textContent=known+'/'+VOCAB.length;
}
let shuffled=false;
function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}

/* ============================================================
   GRAMMAR
   ============================================================ */
function renderGrammar(){
  const host=$('#grammar-container');host.innerHTML='';
  const groups=[{k:'d1',t:'Ngày 1 — Sửa lỗi câu'},{k:'d2',t:'Ngày 2 — Dịch Việt → Anh'},{k:'d3',t:'Ngày 3 — Sửa lỗi câu'},{k:'d5',t:'Ngày 5 — Lỗi dịch máy'},{k:'d10',t:'Ngày 10 — Past tense kể chuyện'}];
  let gi=0;
  groups.forEach(g=>{
    const sec=document.createElement('div');sec.className='card';
    sec.innerHTML=`<h3>${g.t}</h3><div id="g-${g.k}"></div>`;
    host.appendChild(sec);
    GRAMMAR[g.k].forEach(ex=>{
      const done=!!gramDone[ex.wrong];
      const id='gx-'+(gi++);
      sec.querySelector('#g-'+g.k).insertAdjacentHTML('beforeend',`
        <div class="qblock">
          <div class="qstem" style="margin-bottom:6px"><b style="color:var(--amber)">✏️</b> <span style="color:var(--txt)">${ex.wrong}</span> <span class="tag ${done?'green':'amber'}" style="margin-left:6px">${done?'✓ đã sửa':'chưa sửa'}</span></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:6px"><input class="input" id="${id}-in" placeholder="Gõ câu đã sửa vào đây..." ${done?'disabled':''} value="${done?(gramDone[ex.wrong]||''):''}"><button class="btn small" data-gchk="${id}" ${done?'disabled':''}>Kiểm tra</button></div>
          <div class="feedback" id="${id}-fb"></div>
          <div style="font-size:12px;color:var(--dim)">💡 Gợi ý: ${ex.hint}</div>
        </div>`);
      const btn=sec.querySelector('[data-gchk="'+id+'"]');
      btn.addEventListener('click',()=>{
        const inp=$('#'+id+'-in'),fb=$('#'+id+'-fb');
        const val=inp.value.trim().toLowerCase();
        const ok=normalize(val)===normalize(ex.right.toLowerCase());
        if(ok){
          gramDone[ex.wrong]=inp.value.trim();store.set('ielts_gram',gramDone);
          fb.className='feedback ok show';fb.innerHTML='✅ Đúng! '+ex.rule;
          inp.disabled=true;btn.disabled=true;
          sec.querySelector('.tag').outerHTML='<span class="tag green">✓ đã sửa</span>';
          updateGrammarNav();
        }else{
          fb.className='feedback no show';fb.innerHTML='❌ Chưa đúng. Đáp án: '+ex.right+'<br>📖 '+ex.rule;
          fb.scrollIntoView({block:'nearest'});
        }
      });
    });
  });
  updateGrammarNav();
}
function normalize(s){return s.replace(/[^\w\s]/g,' ').replace(/\s+/g,' ').trim();}
function updateGrammarNav(){
  const done=Object.keys(gramDone).length;
  $('#nav-grammar-pct').textContent=done+'/'+GRAMMAR_LIST.length;
}

/* ============================================================
   WRITING
   ============================================================ */
function renderWriting(){
  const host=$('#writing-container');host.innerHTML='';
  WRITING.forEach(w=>{
    const card=document.createElement('div');card.className='card';card.id='w-'+w.id;
    card.innerHTML=`
      <h3>${w.day}</h3>
      <p style="background:var(--bg2);border:1px solid var(--border);padding:12px 14px;border-radius:var(--radius-s)"><b>✍️ Đề:</b> ${w.prompt}</p>
      <p style="color:var(--muted);font-size:13px">⚙️ ${w.task}</p>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin:10px 0">
        <button class="btn small" data-wt="${w.id}">⏱ ${w.timer?w.timer:'Bấm giờ 20:00'}</button>
        <span class="tag" id="${w.id}-timer">—</span>
        <button class="btn small primary" data-ws="${w.id}">💾 Lưu bài</button>
        <button class="btn small" data-wr="${w.id}">🔄 Xóa</button>
      </div>
      <textarea class="input writing" id="${w.id}-ta" placeholder="Viết bài của bạn ở đây...">${w.saved||''}</textarea>
      <div class="wcbar"><span>Từ: <b id="${w.id}-words">0</b></span><span>${w.vocab.length} từ vựng gợi ý</span></div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 12px">${w.vocab.map(v=>`<span class="tag acc">${v}</span>`).join('')}</div>
      <details><summary style="cursor:pointer;color:var(--accent);font-size:13px">📖 Xem bài mẫu để so sánh</summary>
        <div style="background:var(--greenbg);border:1px solid rgba(63,185,111,.3);padding:12px 14px;border-radius:var(--radius-s);margin-top:8px;font-size:13.5px">${w.sample||'Bài mẫu: tự chấm theo rubric bên dưới.'}</div></details>
      <h4 style="margin-top:16px">🔍 Tự đánh giá (rubric)</h4>
      <div class="rubric">
        <label><input type="checkbox" data-rub="${w.id}"> Luận điểm rõ ràng, có câu chủ đề</label>
        <label><input type="checkbox" data-rub="${w.id}"> Có lý do + ví dụ cụ thể</label>
        <label><input type="checkbox" data-rub="${w.id}"> Dùng từ vựng collocation chuẩn</label>
        <label><input type="checkbox" data-rub="${w.id}"> Ít lỗi ngữ pháp (số ít/nhiều, thì)</label>
        <label><input type="checkbox" data-rub="${w.id}"> Đúng yêu cầu đề (paraphrase, task)</label>
        <label><input type="checkbox" data-rub="${w.id}"> Đủ/không vượt quá số từ</label>
      </div>`;
    host.appendChild(card);

    const ta=$('#'+w.id+'-ta');
    ta.addEventListener('input',()=>{
      const n=ta.value.trim().split(/\s+/).filter(Boolean).length;
      $('#'+w.id+'-words').textContent=n;
      const bar=$('#'+w.id+'-words');
      bar.style.color=n>=150&&n<=180?'var(--green)':(n<150?'var(--amber)':'var(--red)');
      w.saved=ta.value;
    });
    card.querySelector('[data-ws="'+w.id+'"]').addEventListener('click',()=>{
      writeData[w.id]=ta.value;store.set('ielts_writing',writeData);
      flash('.btn[data-ws="'+w.id+'"]','Đã lưu ✓');
    });
    card.querySelector('[data-wr="'+w.id+'"]').addEventListener('click',()=>{ta.value='';w.saved='';$('#'+w.id+'-words').textContent=0;delete writeData[w.id];store.set('ielts_writing',writeData);});
    card.querySelector('[data-wt="'+w.id+'"]').addEventListener('click',()=>{
      writingTimer={...};
      // simple: 20 min countdown per click using existing mechanism
      if(!w._t){w._t=true;startWqTimer(w.id);}else{clearInterval(w._tm);w._t=false;$('#'+w.id+'-timer').textContent='—';}
    });
  });
}
let writeData=store.get('ielts_writing',{});
function startWqTimer(wid){
  const end=Date.now()+20*60*1000;
  const el=$('#'+wid+'-timer');
  const t=setInterval(()=>{
    const s=Math.max(0,Math.floor((end-Date.now())/1000));
    el.textContent=String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');
    if(s<=0){clearInterval(t);el.textContent='⏰ Hết giờ!';}
  },1000);
  WRITING.find(w=>w.id===wid)._tm=t; // store ref to clear
}
function flash(sel,msg){const el=$(sel);if(el){const old=el.textContent;el.textContent=msg;setTimeout(()=>el.textContent=old,1200);}}

/* ============================================================
   SPEAKING
   ============================================================ */
let recorder=null,chunks=[],recState={};
function renderSpeaking(){
  const host=$('#speaking-container');host.innerHTML='';
  const s=SPEAKING.d1;
  const d=document.createElement('div');d.className='card';
  d.innerHTML=`
    <h3>${s.day}</h3>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:14px">
      <button class="btn small" id="srec">🎙 Bắt đầu ghi âm</button>
      <button class="btn small" id="splay">▶ Nghe lại</button>
      <button class="btn small danger" id="sclear">🗑 Xóa bản ghi</button>
      <span class="rec-status" id="sstatus">Chưa ghi</span>
      <button class="btn small" id="stimer">⏱ Timer 1' chuẩn bị + 2' nói</button>
      <span class="tag" id="sttimer">—</span>
    </div>
    <h4>🗣 Part 1 — Hỏi đáp nhanh (focus)</h4>
    <ul style="line-height:1.9;color:var(--txt)">${s.p1.map((q,i)=>`<li><b>${i+1}.</b> ${q}</li>`).join('')}</ul>
    <h4>💬 Part 2 — Cue card</h4>
    <div class="lesson-obj"><p style="margin:0 0 6px"><b>${s.p2.prompt}</b></p>
      <ul>${s.p2.cues.map(c=>`<li>${c}</li>`).join('')}</ul></div>
    <h4>🔎 Part 3 — Thảo luận</h4>
    <ul style="line-height:1.9;color:var(--txt)">${s.p3.map((q,i)=>`<li><b>${i+1}.</b> ${q}</li>`).join('')}</ul>
    <h4>✅ Checklist tự đánh giá</h4>
    <div class="rubric">
      <label><input type="checkbox" data-sc="f"> Nói trôi chảy, không dừng quá lâu</label>
      <label><input type="checkbox" data-sc="g"> Dùng đúng thì (nhất là quá khứ ở Part 2)</label>
      <label><input type="checkbox" data-sc="v"> Có từ vựng/collocation</label>
      <label><input type="checkbox" data-sc="p"> Phát âm rõ, dễ nghe</label>
      <label><input type="checkbox" data-sc="c"> Trả lời đúng trọng tâm câu hỏi</label>
    </div>
    <details style="margin-top:14px"><summary style="cursor:pointer;color:var(--accent);font-size:13px">📖 Xem câu trả lời mẫu (Part 2)</summary>
      <div style="background:var(--greenbg);border:1px solid rgba(63,185,111,.3);padding:12px 14px;border-radius:var(--radius-s);margin-top:8px;font-size:13.5px">${s.sample}</div></details>`;
  host.appendChild(d);

  $('#srec').addEventListener('click',toggleRec);
  $('#splay').addEventListener('click',playRec);
  $('#sclear').addEventListener('click',()=>{chunks=[];recState.audio=null;$('#sstatus').textContent='Đã xóa bản ghi';});
  $('#stimer').addEventListener('click',startSpeakTimer);
}
function toggleRec(){
  const st=$('#sstatus');
  if(recorder&&recorder.state==='recording'){recorder.stop();st.textContent='Đang xử lý...';return;}
  st.classList.add('live');st.textContent='● ĐANG GHI ÂM...';
  startRec();
}
function startRec(){
  if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){$('#sstatus').textContent='Trình duyệt không hỗ trợ ghi âm. Dùng Chrome/Edge.';return;}
  navigator.mediaDevices.getUserMedia({audio:true}).then(stream=>{
    chunks=[];
    recorder=new MediaRecorder(stream);
    recorder.ondataavailable=e=>{if(e.data.size>0)chunks.push(e.data);};
    recorder.onstop=()=>{
      const blob=new Blob(chunks,{type:'audio/webm'});
      recState.audio=URL.createObjectURL(blob);
      $('.rec-status').classList.remove('live');
      $('.rec-status').textContent='✓ Đã ghi xong. Bấm ▶ Nghe lại.';
      stream.getTracks().forEach(t=>t.stop());
    };
    recorder.start();
  }).catch(()=>{$('.rec-status').classList.remove('live');$('.rec-status').textContent='⚠ Không được phép truy cập mic.';});
}
function playRec(){
  if(recState.audio){const a=new Audio(recState.audio);a.play();}
  else alert('Chưa có bản ghi nào. Hãy ghi âm trước.');
}
function startSpeakTimer(){
  const el=$('#sttimer');
  // 1 min prep then 2 min speak
  let phase='prep',time=60,done=false;
  const t=setInterval(()=>{
    const m=Math.floor(time/60),s=time%60;
    el.textContent=(phase==='prep'?'📋 Chuẩn bị ':'🗣 Nói ')+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');
    time--;
    if(time<0){
      if(phase==='prep'){phase='speak';time=120;const u=new SpeechSynthesisUtterance('Begin speaking now');if('speechSynthesis' in window)speechSynthesis.speak(u);}
      else{clearInterval(t);el.textContent='⏰ Hết giờ nói!';if('speechSynthesis' in window)speechSynthesis.cancel();}
    }
  },1000);
  recState.speakTimer=t;
}

/* ============================================================
   NAV PCT + INIT
   ============================================================ */
function updateNavPct(){
  const done=daysDoneCount();
  $('#sidebar-progress').style.width=(done/21*100)+'%';
  $('#sidebar-progress-text').textContent=done+'/21 ngày';
}

/* INIT */
document.addEventListener('DOMContentLoaded',()=>{
  // load writing saves
  Object.assign(WRITING,{});
  WRITING.forEach(w=>{if(writeData[w.id])w.saved=writeData[w.id];});
  bindNav();
  renderHome();
  renderDayPicker();
  renderLesson();
  renderReading();
  renderListening();
  renderVocabFilters();
  renderVocab();
  renderGrammar();
  renderWriting();
  renderSpeaking();
  $('#vocab-shuffle').addEventListener('click',()=>{shuffled=!shuffled;renderVocab();});
  $('#vocab-filter-btn').addEventListener('click',()=>{
    const next=vocabSetFilter==='all'?'known':vocabSetFilter==='known'?'unknown':vocabSetFilter==='unknown'?'none':'all';
    vocabSetFilter=next;
    $('#vocab-filter-btn').textContent='🔍 '+(next==='all'?'Đã học / chưa học':next==='known'?'Đã biết':next==='unknown'?'Chưa biết':'Chưa đánh dấu');
    renderVocab();
  });
  $('#vocab-reset').addEventListener('click',()=>{if(confirm('Reset toàn bộ tiến độ flashcards?')){vocabState={};store.set('ielts_vocab',vocabState);renderVocab();}});
  // preload voices
  if('speechSynthesis' in window){speechSynthesis.getVoices();speechSynthesis.onvoiceschanged=()=>{};}
  updateListenNav2();
});
function updateListenNav2(){updateListeningNav();}
</script>