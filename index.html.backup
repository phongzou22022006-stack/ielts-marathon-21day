/* ---- GRAMMAR exercises ---- */
const GRAMMAR = {
  d1:[
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"Many student checks their phone while they are study.", right:"Many students check their phones while they are studying.", rule:"Chủ ngữ số nhiều 'students' → động từ nguyên mẫu 'check'. Danh từ 'phones' số nhiều. 'While they are studying' (V-ing sau 'are').", hint:"students / check / studying"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"Because notifications make it difficult to focus.", right:"Notifications make it difficult to focus.", rule:"Đây là mệnh đề phụ (fragment) — thiếu mệnh đề chính. Bỏ 'Because' để thành câu hoàn chỉnh.", hint:"Bỏ 'Because'"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"The number of interruptions are increasing during online lessons.", right:"The number of interruptions is increasing during online lessons.", rule:"'The number of' là số ít → 'is'. 'A number of' mới dùng 'are'.", hint:"is increasing"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"Students can lose many informations when they change tasks quickly.", right:"Students can lose a lot of information when they change tasks quickly.", rule:"'information' là danh từ không đếm được → không có 'many informations'. Dùng 'a lot of information'.", hint:"a lot of information"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"Although technology is useful but it can become distracting.", right:"Although technology is useful, it can become distracting.", rule:"Không dùng 'but' cùng 'although' trong cùng câu — thừa liên từ.", hint:"Bỏ 'but', thêm phẩy"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"I spend too much time to check social media.", right:"I spend too much time checking social media.", rule:"'spend time + V-ing' (không phải 'to V').", hint:"spend time checking"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"People who studies in noisy places may find difficult to concentrate.", right:"People who study in noisy places may find it difficult to concentrate.", rule:"Đại từ quan hệ 'who' + chủ ngữ số nhiều 'people' → 'study'. Cấu trúc 'find it + adj + to V'.", hint:"who study / find it"},
    {day:"Ngày 1 — Sửa lỗi câu", wrong:"This habit affects badly to their academic performance.", right:"This habit badly affects their academic performance.", rule:"'affect' là ngoại động từ → trực tiếp + tân ngữ, không cần 'to'. Trạng từ 'badly' đứng trước động từ.", hint:"badly affects"}
  ],
  d2:[
    {day:"Ngày 2 — Dịch Việt → Anh", wrong:"Tôi rất thích học vào ban đêm.", right:"I really enjoy studying at night.", rule:"'enjoy + V-ing' (thích + động từ thêm ing).", hint:"enjoy studying"},
    {day:"Ngày 2 — Dịch Việt → Anh", wrong:"Điện thoại làm tôi mất tập trung hơn và hơn.", right:"Phones make me lose more and more concentration.", rule:"'more and more + danh từ' (ngày càng nhiều). Điện thoại số nhiều → 'phones'.", hint:"make me lose / more and more"},
    {day:"Ngày 2 — Dịch Việt → Anh", wrong:"Tôi bị áp lực vì có quá nhiều bài tập về nhà.", right:"I'm under pressure because there are too many homework assignments.", rule:"'be under pressure' (bị áp lực). 'because there are too many + danh từ đếm được'.", hint:"under pressure / because there are too many"},
    {day:"Ngày 2 — Dịch Việt → Anh", wrong:"Tôi muốn cải thiện bản thân trong tiếng Anh.", right:"I want to improve my English.", rule:"'want to + V'. 'improve my English' (cải thiện trình độ) — không nói 'improve myself in English'.", hint:"want to improve my English"}
  ],
  d3:[
    {day:"Ngày 3 — Sửa lỗi câu", wrong:"Libraries give people many knowledges.", right:"Libraries give people a great deal of useful information.", rule:"'knowledge' và 'information' là danh từ không đếm được — không có 's'. Dùng 'a great deal of'.", hint:"a great deal of information"},
    {day:"Ngày 3 — Sửa lỗi câu", wrong:"The government should invest money for public libraries.", right:"The government should invest money in public libraries.", rule:"'invest money in + danh từ' (đầu tư vào).", hint:"invest money in"},
    {day:"Ngày 3 — Sửa lỗi câu", wrong:"People can approach reliable information there.", right:"People can access reliable information there.", rule:"'access' (truy cập) đúng hơn 'approach' trong ngữ cảnh thông tin.", hint:"can access"},
    {day:"Ngày 3 — Sửa lỗi câu", wrong:"This service is very convenience for poor people.", right:"This service is very convenient for disadvantaged people.", rule:"'convenient' là tính từ (không phải 'convenience'). 'disadvantaged people' là cách diễn đạt nhạy cảm hơn 'poor'.", hint:"very convenient"},
    {day:"Ngày 3 — Sửa lỗi câu", wrong:"The library has less visitors than before, but they stay longer.", right:"The library has fewer visitors than before, but they stay longer.", rule:"'visitors' là danh từ đếm được → 'fewer' (không phải 'less').", hint:"fewer visitors"}
  ],
  d5:[
    {day:"Ngày 5 — Lỗi dịch máy", wrong:"My English level is increasing every day more and more.", right:"My English is improving day by day.", rule:"Bỏ dịch máy từng chữ ('level is increasing'). Diễn đạt tự nhiên: 'improving day by day'.", hint:"improving day by day"},
    {day:"Ngày 5 — Lỗi dịch máy", wrong:"I am very interested in English grammar skills.", right:"I am very interested in English grammar.", rule:"'grammar' không cần thêm 'skills' lặp thừa.", hint:"interested in English grammar"},
    {day:"Ngày 5 — Lỗi dịch máy", wrong:"In my opinion I think that reading is important.", right:"In my opinion, reading is important.", rule:"Thừa lặp: 'in my opinion' + 'I think' → chỉ dùng một.", hint:"In my opinion, reading is important"},
    {day:"Ngày 5 — Lỗi dịch máy", wrong:"Nowadays, the people use smartphones a lot.", right:"Nowadays, people use smartphones a lot.", rule:"'people' chung chung → không dùng 'the'.", hint:"Nowadays, people use"},
    {day:"Ngày 5 — Lỗi dịch máy", wrong:"I very like learning English with my friends.", right:"I really like learning English with my friends.", rule:"'very' không đứng trước động từ 'like'. Dùng 'really' hoặc 'like ... very much'.", hint:"really like"}
  ],
  d10:[
    {day:"Ngày 10 — Past tense kể chuyện", wrong:"Yesterday I go to the library and study for two hours.", right:"Yesterday I went to the library and studied for two hours.", rule:"'Yesterday' → quá khứ. 'go' → 'went', 'study' → 'studied'.", hint:"went / studied"},
    {day:"Ngày 10 — Past tense kể chuyện", wrong:"Last year, I hadn't enough time to practice speaking.", right:"Last year, I didn't have enough time to practice speaking.", rule:"Diễn tả sự việc không xảy ra trong quá khứ đơn → 'didn't have' (không dùng 'hadn't' ở đây).", hint:"didn't have"},
    {day:"Ngày 10 — Past tense kể chuyện", wrong:"When I was a child, I used to played football every day.", right:"When I was a child, I used to play football every day.", rule:"'used to + V nguyên mẫu' (thói quen quá khứ).", hint:"used to play"},
    {day:"Ngày 10 — Past tense kể chuyện", wrong:"She told me that she will come to the class next day.", right:"She told me that she would come to the class the next day.", rule:"Câu tường thuật gián tiếp → 'will' → 'would', 'next day' → 'the next day'.", hint:"would come / the next day"}
  ]
};
const GRAMMAR_LIST = [].concat(GRAMMAR.d1, GRAMMAR.d2, GRAMMAR.d3, GRAMMAR.d5, GRAMMAR.d10);

/* ---- WRITING prompts ---- */
const WRITING = [
  {id:"w1", day:"Ngày 1 — Task 2 Body", prompt:"Some people believe that secondary schools should ban students from using smartphones during the entire school day. To what extent do you agree or disagree?", task:"Viết MỘT đoạn thân bài (150-170 từ) nêu luận điểm + lý do + ví dụ.", vocab:["sustain attention","under pressure","a recurring error","applying knowledge"], sample:"Many students, I would argue, lose a significant amount of focus when smartphones are always at hand. Even silent phones interrupt; a recurring error is to assume that glancing at a screen has no cost, but each glance draws attention away from the lesson and makes it harder to rebuild concentration. When students study in focused blocks without devices, they retain information more effectively and complete tasks more quickly. Furthermore, banning phones during class encourages responsibility and prevents online distractions from putting learners under unnecessary pressure. For these reasons, I agree that restricting smartphone use for the whole school day helps students engage more deeply with their studies."},
  {id:"w2", day:"Ngày 2 — Thesis", prompt:"Phân tích 5 đề & viết câu thesis (luận điểm):", task:"1) Tuition should be free for all. 2) Cities should ban cars in the centre. 3) Schools should focus on practical skills. 4) Remote work should be standard. 5) Museums should be free.", vocab:["a well-rounded education","remain relevant","integrate X into Y","serve different purposes"], sample:"Ví dụ thesis (đề 3): 'While academic knowledge forms an intellectual foundation, I believe schools should balance it with practical skills so that students are prepared for adult life and can apply what they learn in practice.'"},
  {id:"w3", day:"Ngày 3 — Task 2 Body (paraphrase)", prompt:"Public libraries are no longer necessary because most information is available online. To what extent do you agree or disagree?", task:"Viết MỘT đoạn thân bài. Paraphrase đề ở câu mở đầu.", vocab:["bridge the digital divide","a reliable source","evaluate information critically","a community hub"], sample:"Many assume that because the internet now holds most information, public libraries have lost their purpose. However, I believe libraries remain essential because not everyone is online, and access alone is not the same as guidance. Libraries bridge the digital divide by offering free computers and a reliable source of help, teaching visitors to evaluate information critically rather than simply consume it. They also function as a community hub and a safe indoor space for those who would otherwise have nowhere quiet to study. Information online is abundant, but a trustworthy, guided environment is not."},
  {id:"w6", day:"Ngày 6 — Task 1 (charts)", prompt:"Bar chart: số khách đến thư viện theo độ tuổi, năm 2010 vs 2025.", task:"Viết Overview + 2 đoạn chi tiết (120-180 từ). Dùng cụm chỉ số liệu.", vocab:["a noticeable upward trend","remain broadly stable","account for the largest share","an exception to the pattern","the gap widened"], sample:"Overview: The chart compares library visitors by age group in 2010 and 2025. Overall, visits rose for most groups, with the largest share accounted for by adults in 2025, while younger visitors remained the most stable group. Body: Visitors aged 25–44 showed a noticeable upward trend, growing from around 40% to a clear majority, becoming an exception to the otherwise slower growth elsewhere. In contrast, the 55+ group declined slightly, and the gap between the oldest and youngest visitors widened over the fifteen-year period."},
  {id:"w7", day:"Ngày 7 — Tự đánh giá Task", prompt:"Chọn 1 bài Task 1 hoặc Task 2 bạn đã viết tuần này, tự chấm theo rubric dưới đây.", task:"Dùng checklist bên dưới để tự đánh giá. Sửa 2 lỗi lặp lại.", vocab:["judge progress","a recurring error","prioritise an error"], sample:""},
  {id:"w8", day:"Ngày 8 — Task 2", prompt:"Many teenagers spend a large amount of time watching short videos online. What effects can this have on their learning and social life?", task:"Viết đoạn thân bài (150-170 từ) về ẢNH HƯỞNG.", vocab:["short-form content","passive consumption","sustained attention","social comparison","hold information in memory"], sample:"Watching short-form content in large amounts can weaken teenagers' ability to sustain attention, because constant stimulation trains the brain to expect an instant reward and makes longer tasks feel dull. This passive consumption may replace deeper learning, leaving students less able to hold information in memory for exams. Socially, the effect is also mixed: social comparison in a personalised feed can lower self-esteem, while endless scrolling reduces real face-to-face conversation. If teenagers do not introduce friction and use technology deliberately, these habits can quietly reshape both how they learn and how they connect with others."}
];

/* ---- SPEAKING data ---- */
const SPEAKING = {
  d1:{
    day:"Ngày 1 — Part 1, 2, 3 (Focus & Technology)",
    p1:["What do you usually do when you need to concentrate?","Do you often check your phone while studying?","What subject did you find most difficult at school?","Do you prefer studying in silence or with background noise?","Are you good at managing your time?","What would you like to improve about your English?"],
    p2:{prompt:"Describe a time when you changed the way you studied.", cues:["What you changed","Why you changed it","How it felt","And how it affected your results"]},
    p3:["Do you think technology makes people more distracted?","Why do some people find it hard to focus while others do not?","Should schools teach students how to manage attention?","Do you think multitasking is a useful skill or a harmful habit?"],
    sample:"Part 2 - mẫu: 'I'd like to talk about a time when I changed my study routine. Last year I realised I was constantly checking my phone, losing track of my work. So I decided to study in focused blocks: I would turn my phone off, work for about fifty minutes, and take a planned break. At first it felt uncomfortable because I was used to being interrupted, but over time I rebuilt my concentration. The effect was clear: I finished tasks faster and remembered more, and the sense of progress kept me motivated.'"
  }
};

/* ---- 21 DAY LESSONS ---- */
const DAYS = [
  {n:1, phase:1, title:"Đánh giá baseline", tag:"Reading · Speaking · Writing", focus:"Làm bài test đầu vào Reading, Writing và Speaking mức vừa để biết điểm xuất phát.", obj:["Xác định band hiện tại của Reading/Writing/Speaking","Nhận diện 3 lỗi phổ biến nhất của mình","Đặt mục tiêu band thực tế cho ngày 21"], products:["Kết quả 3 bài test đầu vào kèm ghi chú band","Danh sách 3 lỗi ưu tiên cần sửa"]},
  {n:2, phase:1, title:"Thesis & cấu trúc luận", tag:"Writing", focus:"Viết luận điểm (thesis) rõ ràng, tranh luận có cấu trúc.", obj:["Hiểu công thức 1 câu thesis: quan điểm + lý do","Phân biệt agree/disagree, discuss both views, advantages/disadvantages","Viết thesis cho 5 đề mẫu"], products:["5 câu thesis cho 5 đề đã cho","1 đoạn body theo mẫu ngày 1"]},
  {n:3, phase:1, title:"Bằng chứng & paraphrase", tag:"Reading · Writing", focus:"Tìm bằng chứng trong bài và đổi cách diễn đạt.", obj:["Nhận biết synonym + paraphrase","Tìm bằng chứng hỗ trợ đáp án Reading","Paraphrase lại câu hỏi và đoạn văn"], products:["Paraphrase 5 câu từ Passage 3","1 đoạn body paraphrase đề 'libraries unnecessary'"]},
  {n:4, phase:1, title:"Speaking fluency", tag:"Speaking", focus:"Nói trôi chảy, dùng pause & recovery phrases đúng chỗ.", obj:["Hiểu vai trò của pause trong fluency","Học 5 recovery phrases","Nói Part 1 mạch lạc theo chủ đề focus"], products:["Bản ghi âm trả lời Part 1 (6 câu)","Danh sách recovery phrases đã dùng"]},
  {n:5, phase:1, title:"Lỗi dịch máy & collocations", tag:"Grammar · Vocabulary", focus:"Sửa lỗi dịch từng chữ từ tiếng Việt, dùng collocation chuẩn.", obj:["Nhận diện 5 lỗi dịch máy phổ biến","Học collocations chủ đề focus/education","Sửa câu theo đúng ngữ pháp tự nhiên"], products:["5 câu đã sửa từ dạng dịch máy","Flashcards collocations Ngày 5"]},
  {n:6, phase:1, title:"Task 1 — features", tag:"Writing", focus:"Chọn và mô tả đặc điểm chính của biểu đồ.", obj:["Hiểu các cụm chỉ xu hướng (trend/decline/stable)","Viết overview từ biểu đồ","Tránh phóng đại khác biệt"], products:["Overview + 2 đoạn chi tiết cho chart Ngày 6","Danh sách số liệu đã dùng đúng ngữ cảnh"]},
  {n:7, phase:1, title:"Đánh giá tuần 1", tag:"Tổng kết", focus:"Nhìn lại tuần, đánh giá tiến bộ bằng 'small wins'.", obj:["Hiểu tâm lý của small wins","Đếm và ghi lại các small wins tuần 1","Đặt mục tiêu tuần 2"], products:["Danh sách small wins của bạn","Mục tiêu tuần 2"]},
  {n:8, phase:2, title:"Phát triển ý Task 2", tag:"Writing", focus:"Phát triển luận điểm thành đoạn có lý do và ví dụ.", obj:["Hiểu cách mở rộng 1 luận điểm (lý do → ví dụ → kết luận)","Phân tích ảnh hưởng của video ngắn lên học tập/xã hội","Viết được đoạn body mạch lạc"], products:["1 đoạn body đề 'short videos' (150-170 từ)"]},
  {n:9, phase:2, title:"Chức năng đoạn văn", tag:"Reading · Writing", focus:"Nhận biết chức năng từng đoạn (topic sentence, evidence, conclusion).", obj:["Xác định câu chủ đề (topic sentence)","Phân loại chức năng các đoạn trong Passage 4","Áp dụng vào viết"], products:["Bảng phân tích 5 đoạn văn theo chức năng"]},
  {n:10, phase:2, title:"Story bank cho Speaking", tag:"Speaking", focus:"Xây kho câu chuyện cá nhân kể bằng quá khứ.", obj:["Thu thập 3 câu chuyện cá nhân đa dụng","Luyện thì quá khứ trong kể chuyện","Nói Part 2 trong 2 phút"], products:["3 câu chuyện cá nhân (story bank)","Bản ghi âm Part 2"]},
  {n:11, phase:2, title:"Ngữ pháp tranh luận", tag:"Grammar · Writing", focus:"Dùng ngữ pháp chính xác khi đưa lập luận.", obj:["Sửa lỗi ngữ pháp trong câu tranh luận","Dùng đúng mệnh đề quan hệ & liên từ","Viết câu đúng về education"], products:["Bài sửa lỗi ngữ pháp đã hoàn thành"]},
  {n:12, phase:2, title:"Độ chính xác Task 1", tag:"Writing", focus:"Nêu số liệu chính xác, không phóng đại.", obj:["Đặt số liệu vào đúng ngữ cảnh","Dùng 'a narrow margin', 'account for' chuẩn","Tránh exaggerate khác biệt"], products:["1 bản mô tả chart chỉnh lại độ chính xác"]},
  {n:13, phase:2, title:"Góc nhìn rộng Part 3", tag:"Speaking", focus:"Phát triển quan điểm đa chiều, có ví dụ.", obj:["Trả lời câu hỏi Part 3 đầy đủ ý","Dùng kỹ thuật 'one topic, three angles'","Luyện câu nói trôi chảy, rõ ý"], products:["Bản ghi âm 4 câu Part 3"]},
  {n:14, phase:2, title:"Đánh giá có thời gian", tag:"Tổng kết", focus:"Làm bài kiểm tra trong thời gian giới hạn.", obj:["Làm Reading + Writing tính giờ","Quản lý thời gian từng phần","Nhận diện lỗi khi gấp rút"], products:["Kết quả test tính giờ + tự phân tích"]},
  {n:15, phase:3, title:"Timed Reading", tag:"Reading", focus:"Reading trong 60 phút với áp lực thời gian.", obj:["Hoàn thành bài Reading đúng giờ","Chiến lược skim & scan","Tự chấm điểm từng passage"], products:["Điểm Reading tính giờ + phân tích lỗi"]},
  {n:16, phase:3, title:"Timed Writing", tag:"Writing", focus:"Task 1 + Task 2 trong đúng thời gian thi.", obj:["Viết Task 1 (~20 phút) + Task 2 (~40 phút)","Tự chấm theo rubric","Sửa lỗi vội vàng"], products:["2 bài viết có thời gian + tự đánh giá"]},
  {n:17, phase:3, title:"Speaking mock test", tag:"Speaking", focus:"Full mock test Speaking Part 1-2-3.", obj:["Thực hiện full mock test","Ghi âm toàn bộ","Đánh giá theo tiêu chí IELTS"], products:["Bản ghi âm mock test + rubric đánh giá"]},
  {n:18, phase:3, title:"Sửa lỗi ưu tiên", tag:"Tổng hợp", focus:"Tập trung sửa lỗi lặp lại nghiêm trọng nhất.", obj:["Nhận diện lỗi tần suất cao từ các bài gần đây","Ưu tiên sửa 3 lỗi quan trọng nhất","Luyện lại có ý thức tránh lỗi"], products:["Bảng theo dõi 3 lỗi ưu tiên + bài luyện"]},
  {n:19, phase:3, title:"Một chủ đề, ba kỹ năng", tag:"Reading · Writing · Speaking", focus:"Chọn 1 chủ đề dùng cho cả Reading, Writing, Speaking.", obj:["Chọn chủ đề (vd: technology, education)","Viết + nói + đọc về cùng chủ đề","Tận dụng từ vựng chung"], products:["1 chủ đề xử lý 3 kỹ năng"]},
  {n:20, phase:3, title:"Full IELTS mock test", tag:"Mock", focus:"Toàn bộ bài thi IELTS trong điều kiện thi thật.", obj:["Làm đủ Reading, Writing, Speaking (không Listening vì sách không có)","Chấm điểm theo band","Nhận diện điểm yếu chót"], products:["Điểm tổng mock test + kế hoạch ôn chót"]},
  {n:21, phase:3, title:"Đánh giá cuối", tag:"Tổng kết", focus:"So sánh baseline vs kết quả, lập kế hoạch sau khóa.", obj:["So sánh điểm ngày 1 và ngày 21","Đếm toàn bộ small wins","Lập kế hoạch duy trì & nâng band"], products:["Bản đánh giá cuối khóa + kế hoạch sau 21 ngày"]}
