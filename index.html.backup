    text:PASSAGES.p3.text,
    questions:[
      {t:"mc", stem:"Q1. Thư viện hiện đại đang làm gì?", opts:["A. Chỉ cho mượn sách","B. Mở rộng ra công nghệ, học có hướng dẫn, chương trình cộng đồng","C. Đóng cửa khu yên tĩnh hoàn toàn","D. Thu phí truy cập"], ans:1, explain:"'offer technology access, guided learning and community programmes.'"},
      {t:"mc", stem:"Q2. Một số khách lo lắng về điều gì?", opts:["A. Giá mượn sách tăng","B. Mất đi môi trường yên tĩnh","C. Quá nhiều sách","D. Thiếu wifi"], ans:1, explain:"'Some visitors still worry about the loss of the quiet environment.'"},
      {t:"gap", stem:"Q3. Thư viện hướng tới việc thu hẹp [_____] (khoảng cách số) bằng cách cho miễn phí máy tính và internet.", ans:["digital divide"], explain:"'bridge the digital divide by giving free access to computers and the internet.'"},
      {t:"mc", stem:"Q4. Thước đo truyền thống (lending statistics) có thể hiện đầy đủ giá trị thư viện không?", opts:["A. Có, chính xác tuyệt đối","B. Không, giá trị thường vô hình trong số liệu đó","C. Có, vì đo mọi hoạt động","D. Không bao giờ đếm được sách"], ans:1, explain:"'value... invisible in traditional lending statistics' → B."}
    ]
  },
  p4:{
    title:"Nghe – Chủ đề: The role of pauses (Ngày 4)",
    source:"Dựa theo Passage 4",
    text:PASSAGES.p4.text,
    questions:[
      {t:"mc", stem:"Q1. Quan điểm chính về pauses?", opts:["A. Pause luôn là dấu hiệu yếu kém","B. Pause đặt đúng chỗ giúp dễ hiểu hơn","C. Phải nói thật nhanh mới fluent","D. Không bao giờ nên dừng"], ans:1, explain:"'well-placed pauses can make a speaker easier to understand.'"},
      {t:"gap", stem:"Q2. Vị trí pause giữa các [_____] (cụm từ) thì tự nhiên.", ans:["phrases"], explain:"'a pause between phrases sounds natural.'"},
      {t:"mc", stem:"Q3. 'Recovery phrases' có tác dụng gì?", opts:["A. Làm câu dài hơn","B. Mua thời gian mà không phá vỡ sự trôi chảy","C. Giảm từ vựng","D. Bắt buộc phải dùng"], ans:1, explain:"Recovery phrases 'buy time without breaking fluency' → B."},
      {t:"mc", stem:"Q4. Cách luyện nói có trọng tâm được gợi ý?", opts:["A. Chỉ học lý thuyết","B. Ghi âm, nghe lại, lặp lại đoạn khó","C. Nói thật to","D. Học thuộc lòng từ điển"], ans:1, explain:"'Recording yourself, listening back, repeating a difficult section' → B."}
    ]
  },
  p7:{
    title:"Nghe – Chủ đề: Psychology of small wins (Ngày 7)",
    source:"Dựa theo Passage 7",
    text:PASSAGES.p7.text,
    questions:[
      {t:"mc", stem:"Q1. Vì sao mục tiêu lớn dễ làm ta nản?", opts:["A. Vì quá dễ","B. Vì chúng xa vời và khoảng cách làm giảm động lực","C. Vì tốn tiền","D. Vì khó nói"], ans:1, explain:"'Big goals can feel distant, and distance discourages.'"},
      {t:"gap", stem:"Q2. Small win giải phóng cảm giác (thành tựu) ... giúp thúc đẩy bước tiếp.", ans:["accomplishment"], explain:"'releases a sense of accomplishment that fuels the next step.'"},
      {t:"mc", stem:"Q3. Vì sao checklist/trackers hoạt động?", opts:["A. Vì tự động tăng điểm","B. Tiến bộ nhìn thấy được thì tạo động lực","C. Vì chúng thay thế mục tiêu","D. Vì giảm việc làm"], ans:1, explain:"'Progress that is visible is progress that motivates.'"},
      {t:"mc", stem:"Q4. Mục tiêu được chọn tốt nên thế nào?", opts:["A. Thật nhỏ và vô nghĩa","B. Không quá sức cũng không vô nghĩa","C. Luôn là mục tiêu lớn","D. Đặt ở ngoài khả năng"], ans:1, explain:"'neither overwhelming nor pointless.' → B."}
    ]
  },
  p8:{
    title:"Nghe – Chủ đề: Short-form video & attention (Ngày 8)",
    source:"Dựa theo Passage 8",
    text:PASSAGES.p8.text,
    questions:[
      {t:"mc", stem:"Q1. Vì sao video ngắn khiến ta xem dễ dàng?", opts:["A. Vì quá ngắn để gây nghiện","B. Từng yếu tố được thiết kế để cho phần thưởng tức thì","C. Vì không có âm thanh","D. Vì không có quảng cáo"], ans:1, explain:"'engineered to deliver an instant reward.'"},
      {t:"gap", stem:"Q2. A personalised feed học điều gì thu hút sự chú ý của bạn rồi cho thêm [_____] (nhiều hơn về nó).", ans:["more of it"], explain:"'learns what captures your attention and offers more of it.'"},
      {t:"mc", stem:"Q3. Điều gì giúp khôi phục kiểm soát?", opts:["A. Xem nhiều hơn","B. Cố ý tạo trì hoãn/dùng công nghệ có chủ đích","C. Tắt tiếng","D. Nâng thời lượng xem"], ans:1, explain:"'introducing a deliberate delay, or using technology deliberately, restores control.'"},
      {t:"mc", stem:"Q4. Quan điểm của bài về video ngắn?", opts:["A. Tất cả đều xấu","B. Video ngắn không xấu, vấn đề là frictriction/kiểm soát","C. Nên cấm hoàn toàn","D. Nên xem không giới hạn"], ans:1, explain:"'None of this means short videos are bad... the question is friction.'"}
    ]
  }
};

